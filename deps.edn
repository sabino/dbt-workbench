{:paths ["src" "resources"]
 :mvn/repos {"central" {:url "https://repo.maven.apache.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        cheshire/cheshire {:mvn/version "6.1.0"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1364"}
        metosin/malli {:mvn/version "0.19.2"}
        org.duckdb/duckdb_jdbc {:mvn/version "1.5.6.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.50.3.0"}
        com.github.jsqlparser/jsqlparser {:mvn/version "5.3"}}
 :aliases {:run {:jvm-opts ["--enable-native-access=ALL-UNNAMED"] :main-opts ["-m" "dbt-workbench.server"]}
           :test {:jvm-opts ["--enable-native-access=ALL-UNNAMED"] :extra-paths ["test"] :main-opts ["-m" "dbt-workbench.test-runner"]}}}
